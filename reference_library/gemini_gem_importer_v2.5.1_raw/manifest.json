{
  "manifest_version": 3,
  "name": "Gemini Gem TXT Importer",
  "version": "2.5.1",
  "description": "Batch-create Gemini Gems by copying TXT content into Gem instructions.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "批量导入 Gemini Gem",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
